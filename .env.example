# PDF Extract Service - Configuration
# Copiar a .env y ajustar valores según entorno

# Application
APP_NAME="PDF Extract Service"
APP_VERSION="0.1.0"

# PDF Extraction Limits
APP_MAX_PDF_SIZE_BYTES=10485760          # 10 MB (10 * 1024 * 1024)
APP_EXTRACT_WORKERS=2                    # Workers ThreadPoolExecutor
APP_MAX_PENDING_EXTRACTIONS=100          # Cola acotada (bulkhead)
APP_EXTRACTION_TIMEOUT_SECONDS=30        # Timeout por extracción

# OCR
APP_OCR_ENABLED=false                    # Habilita OCR (Tesseract)
APP_OCR_LANGUAGES=eng,spa                # Idiomas Tesseract (separados por coma)

# Logging
APP_LOG_LEVEL=INFO                       # DEBUG, INFO, WARNING, ERROR
APP_LOG_FORMAT=text                      # text | json

# Server
PORT=8000                                # Puerto HTTP (Railway/Render/Cloud Run lo inyectan)